<?xml version="1.0"?>
<ruleset name="Custom Woo Pro Carousel">
    <description>WordPress Coding Standards for the Custom Woo Pro Carousel plugin.</description>

    <!-- WPCS rule sets: Core + Extra. -->
    <rule ref="WordPress"/>
    <rule ref="WordPress-Extra"/>

    <!-- The design uses descriptive module filenames (class-plugin.php,
         class-query.php, ...). Keep the class- prefix convention but let the
         filename sniff pass against the CamelCase class name. -->
    <rule ref="WordPress.Files.FileName">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <!-- Scan the whole plugin repository. -->
    <file>.</file>

    <!-- Exclude any directories that are never shipped or never analyzed. -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/assets/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>
</ruleset>