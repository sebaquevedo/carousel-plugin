<?xml version="1.0"?>
<ruleset name="Custom Woo Pro Carousel">
    <description>WordPress Coding Standards for the Custom Woo Pro Carousel plugin.</description>

    <!-- WPCS rule sets: Core + Extra. -->
    <rule ref="WordPress"/>
    <rule ref="WordPress-Extra"/>

    <!-- The design uses descriptive module filenames (class-plugin.php,
         class-query.php, ...). Keep the class- prefix convention but let the
         filename sniff pass against the CamelCase class name. -->
    <rule ref="WordPress.Files.FileName">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <!-- WooCommerce registers `manage_woocommerce` as a dynamic capability at
         runtime; it is not a core WP capability, so the WP.Capabilities sniff
         does not know it. Declaring it keeps the carousel admin gate visible
         to static analysis without weakening the rule (D7 admin). -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array" extend="true">
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- Scan the whole plugin repository. -->
    <file>.</file>

    <!-- Exclude any directories that are never shipped or never analyzed. -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/assets/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>
</ruleset>