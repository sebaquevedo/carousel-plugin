#. Cover-mode editor row label (AS-9).
#: includes/class-admin.php
msgid "Cover mode"
msgstr "Modo portada"

#. Cover-mode checkbox label (AS-9).
#: includes/class-admin.php
msgid "Show cover cards"
msgstr "Mostrar tarjetas de portada"

#. Cover-mode checkbox description (AS-9).
#: includes/class-admin.php
msgid "Render portrait cards with a full-bleed image and a centered overlay title."
msgstr "Muestra tarjetas verticales con imagen a sangre completa y un título centrado superpuesto."

#. Subcategories editor row label (AS-9).
#: includes/class-admin.php
msgid "Subcategories"
msgstr "Subcategorías"

#. Subcategories checkbox label (AS-9).
#: includes/class-admin.php
msgid "Show subcategories"
msgstr "Mostrar subcategorías"

#. Subcategories checkbox description (AS-9).
#: includes/class-admin.php
msgid "List direct child categories instead of the selected categories."
msgstr "Lista las categorías hijas directas en lugar de las categorías seleccionadas."

#. Title-alignment editor row label (AS-9).
#: includes/class-admin.php
msgid "Title alignment"
msgstr "Alineación del título"

#. Title-alignment select options (AS-9).
#: includes/class-admin.php
msgid "Left"
msgstr "Izquierda"

#: includes/class-admin.php
msgid "Center"
msgstr "Centro"

#: includes/class-admin.php
msgid "Right"
msgstr "Derecha"

#. Per-category overlay title input label and chip placeholder (AS-3).
#: includes/class-admin.php includes/class-assets.php
msgid "Overlay title"
msgstr "Título superpuesto"

#. wp.media frame title for the inline per-chip uploader (AS-3).
#: includes/class-assets.php
msgid "Select an image for the category"
msgstr "Selecciona una imagen para la categoría"

#. wp.media frame select button (AS-3).
#: includes/class-assets.php
msgid "Use this image"
msgstr "Usar esta imagen"

#. Chip drag-handle tooltip (D1).
#: includes/class-assets.php
msgid "Drag to reorder"
msgstr "Arrastrar para reordenar"

#. Chip remove-button label (D3).
#: includes/class-assets.php
msgid "Remove"
msgstr "Quitar"

#. Chip upload button label (AS-3).
#: includes/class-assets.php
msgid "Choose image"
msgstr "Elegir imagen"

#. Category search picker placeholder (AS-11).
#: includes/class-admin.php
msgid "Search categories…"
msgstr "Buscar categorías…"

#. Category picker empty-state CTA (AS-12).
#: includes/class-admin.php
msgid "Add categories"
msgstr "Añadir categorías"

#. Category picker description (AS-11).
#: includes/class-admin.php
msgid "Search and select categories; drag the chips to set the carousel order."
msgstr "Busca y selecciona categorías; arrastra las etiquetas para fijar el orden del carrusel."