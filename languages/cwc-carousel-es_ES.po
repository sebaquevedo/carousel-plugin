#. Plugin Name of the plugin
#: custom-woo-pro-carousel.php
msgid "Custom Woo Pro Carousel"
msgstr "Custom Woo Pro Carousel"

#. Description of the plugin
#: custom-woo-pro-carousel.php
msgid "A modular WooCommerce product carousel plugin powered by Swiper."
msgstr "Un plugin modular de carrusel de productos para WooCommerce, impulsado por Swiper."

#. Author of the plugin
#: custom-woo-pro-carousel.php
msgid "Custom Woo Pro Carousel contributors"
msgstr "Colaboradores de Custom Woo Pro Carousel"

