msgstr "Está a punto de eliminar el carrusel \"%s\"."

#: includes/class-admin.php:551
msgid "Pages and shortcodes that reference this name will fall back to the reserved \"default\" carousel — they keep rendering and never fail."
msgstr "Las páginas y los shortcodes que hagan referencia a este nombre pasarán al carrusel reservado \"default\": seguirán mostrándose y nunca fallarán."

#: includes/class-admin.php:558
msgid "Cancel"
msgstr "Cancelar"

#: includes/class-admin.php:581
msgid "Whether the carousel shows products or category cards (product_cat terms)."
msgstr "Indica si el carrusel muestra productos o tarjetas de categoría (términos de product_cat)."

#: includes/class-admin.php:617
msgid "Search categories…"
msgstr "Buscar categorías…"

#: includes/class-admin.php:662
msgid "Add categories"
msgstr "Añadir categorías"

#: includes/class-admin.php:664
msgid "Search and select categories; drag the chips to set the carousel order."
msgstr "Busca y selecciona categorías; arrastra las etiquetas para fijar el orden del carrusel."

#: includes/class-admin.php:700
msgid "Search products…"
msgstr "Buscar productos…"

#: includes/class-admin.php:735
msgid "Add products"
msgstr "Añadir productos"

#: includes/class-admin.php:737
msgid "Search and select products; drag the chips to set the carousel order."
msgstr "Busca y selecciona productos; arrastra las etiquetas para fijar el orden del carrusel."

#: includes/class-admin.php:750
msgid "Desktop"
msgstr "Escritorio"

#: includes/class-admin.php:752
msgid "Tablet"
msgstr "Tableta"

#: includes/class-admin.php:754
msgid "Mobile"
msgstr "Móvil"

#: includes/class-admin.php:785
msgid "0 renders an empty carousel."
msgstr "El valor 0 muestra un carrusel vacío."

#: includes/class-admin.php:801
msgid "Show the Buy button on product cards"
msgstr "Mostrar el botón de compra en las tarjetas de producto"

#: includes/class-admin.php:802
msgid "Buy text"
msgstr "Texto del botón de compra"

#: includes/class-admin.php:828
msgid "Show arrows"
msgstr "Mostrar flechas"

#: includes/class-admin.php:832
msgid "Show pagination"
msgstr "Mostrar paginación"

#: includes/class-admin.php:859
msgid "Show cover cards"
msgstr "Mostrar tarjetas de portada"

#: includes/class-admin.php:860
msgid "Render portrait cards with a full-bleed image and a centered overlay title."
msgstr "Muestra tarjetas verticales con imagen a sangre completa y un título centrado superpuesto."

#: includes/class-admin.php:883
msgid "Show subcategories"
msgstr "Mostrar subcategorías"

#: includes/class-admin.php:884
msgid "List direct child categories instead of the selected categories."
msgstr "Lista las categorías hijas directas en lugar de las categorías seleccionadas."

#: includes/class-admin.php:909
msgid "Left"
msgstr "Izquierda"

#: includes/class-admin.php:910
msgid "Center"
msgstr "Centro"

#: includes/class-admin.php:911
msgid "Right"
msgstr "Derecha"

#: includes/class-admin.php:1076
msgid "The carousel name must contain at least one letter, number, or hyphen."
msgstr "El nombre del carrusel debe contener al menos una letra, un número o un guion."

#: includes/class-admin.php:1078
msgid "\"default\" is a reserved name and cannot be used."
msgstr "\"default\" es un nombre reservado y no se puede usar."

#: includes/class-admin.php:1080
msgid "A carousel with that name already exists."
msgstr "Ya existe un carrusel con ese nombre."

#. translators: %s: instance slug.
